{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskAI",
  "version": "0.1.0",
  "identifier": "com.evan.taskai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskAI",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Evan",
    "shortDescription": "Apuntes que una IA local ordena en vivo",
    "longDescription": "Escribe rápido y desordenado; TaskAI usa una IA local (Ollama) para ordenar tus apuntes, sacar pendientes con fecha y acomodarlos en carpetas. Gratis y privado.",
    "category": "Productivity",
    "copyright": "© 2026 Evan · MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "TaskAI"
      }
    }
  }
}